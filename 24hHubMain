-- ==================== PLAYER UTILITIES TAB ====================
local PlayerGroup = Tabs.Player:AddLeftGroupbox("Character Modifiers")

PlayerGroup:AddToggle('EnableSpeed', {
   Text = 'Custom WalkSpeed',
   Default = false,
   Callback = function(Value)
      _G.CustomSpeed = Value
      task.spawn(function()
         while _G.CustomSpeed do
            pcall(function()
               game:GetService("Players").LocalPlayer.Character.Humanoid.WalkSpeed = _G.SpeedValue or 16
            end)
            task.wait(0.5)
         end
