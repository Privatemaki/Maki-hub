-- MAKI HUB: GENERATOR & RECYCLER MAIN TAB SCRIPT
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local player = Players.LocalPlayer

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UpgradeGeneratorEvent = Remotes:WaitForChild("UpgradeGenerator")
local UpgradeRecyclerEvent = Remotes:FindFirstChild("UpgradeRecycler") -- Palitan kung iba pangalan ng remote ng recycler

local TargetLevel = 30 -- Target level cap mo

-- Money Checker Function
local function getPlayerMoney()
    local success, result = pcall(function()
        local moneyFrame = player.PlayerGui.HUD.Frame.money
        for _, desc in ipairs(moneyFrame:GetDescendants()) do
            if desc:IsA("TextLabel") then
                local txt = desc.Text or ""
                local cleanTxt = txt:upper():gsub(",", ""):gsub("%$", ""):gsub("%s+", "")
                local mult = 1
                if cleanTxt:find("K") then mult = 1000; cleanTxt = cleanTxt:gsub("K", "")
                elseif cleanTxt:find("M") then mult = 1000000; cleanTxt = cleanTxt:gsub("M", "") end
                local num = tonumber(cleanTxt)
                if num then return num * mult end
            end
        end
    end)
    return success and result or 0
end

-- UI Creation sa Main Tab (Dito natin pinagsama sa iisang section para hindi mag-triple)
local MainTab = Window:CreateTab("Main") -- O kung ano man ang tawag sa tab variable mo
local CoopSection = MainTab:CreateSection("Coop Config")

-- Halimbawa ng Toggles para sa Main Tab mo
CoopSection:CreateToggle("Auto Upgrade Feeders", false, function(Value)
    getgenv().AutoFeeders = Value
end)

CoopSection:CreateToggle("Auto Upgrade Recycler", false, function(Value)
    getgenv().AutoRecycler = Value
end)

-- Background Loop para sa Auto Upgrade ng Feeders at Recycler
task.spawn(function()
    while true do
        local currentMoney = getPlayerMoney()
        local coopsFolder = workspace:FindFirstChild("Coops")
        
        if coopsFolder and coopsFolder:FindFirstChild("CoopUI") then
            local coopUI = coopsFolder.CoopUI
            local parts = {}
            for _, child in ipairs(coopUI:GetChildren()) do
                if child.Name == "Part" then
                    table.insert(parts, child)
                end
            end
            
            table.sort(parts, function(a, b) return a.Name < b.Name end)
            
            for i = 1, math.min(#parts, 6) do
                local part = parts[i]
                local detectedLevels = {}
                local upgradeCost = 0
                
                for _, desc in ipairs(part:GetDescendants()) do
                    if desc:IsA("TextLabel") then
                        local txt = desc.Text or ""
                        
                        local lvlMatch = txt:match("[Nn][Vv]%.?%s*(%d+)") or txt:match("[Ll][Vv]%.?%s*(%d+)")
                        if lvlMatch then
                            local parsed = tonumber(lvlMatch)
                            if parsed then table.insert(detectedLevels, parsed) end
                        end
                        
                        for numStr in txt:gmatch("(%d+)") do
                            local n = tonumber(numStr)
                            if n and n > 0 and n < 500 and not txt:find("%$") and not txt:upper():find("COST") then
                                table.insert(detectedLevels, n)
                            end
                        end
                        
                        if txt:find("%$") or txt:upper():find("COST") then
                            local cleanStr = txt:upper():gsub("COST", ""):gsub("%$", ""):gsub(",", ""):gsub("%s+", "")
                            local mult = 1
                            if cleanStr:find("K") then mult = 1000; cleanStr = cleanStr:gsub("K", "")
                            elseif cleanStr:find("M") then mult = 1000000; cleanStr = cleanStr:gsub("M", "") end
                            local cNum = tonumber(cleanStr)
                            if cNum then upgradeCost = cNum * mult end
                        end
                    end
                end
                
                local currentLevel = 0
                for _, lvl in ipairs(detectedLevels) do
                    if lvl > currentLevel then
                        currentLevel = lvl
                    end
                end
                
                local slotID = i
                
                -- Kung naka-on ang Auto Upgrade Feeders toggle
                if getgenv().AutoFeeders then
                    if currentLevel > 0 and currentLevel < TargetLevel then
                        if not (upgradeCost > 0 and currentMoney < upgradeCost) then
                            pcall(function()
                                UpgradeGeneratorEvent:InvokeServer(slotID)
                            end)
                        end
                    end
                end
                
                -- Kung naka-on ang Auto Upgrade Recycler toggle
                if getgenv().AutoRecycler and UpgradeRecyclerEvent then
                    pcall(function()
                        UpgradeRecyclerEvent:InvokeServer(slotID)
                    end)
                end
                
                task.wait(0.2)
            end
        end
        
        task.wait(2)
    end
end)

print("[MakiHub] Na-update na ang Main Tab: Feeders at Recycler ay magkasama na!")
