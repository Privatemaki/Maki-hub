      end)
   end
})

PlayerGroup:AddSlider('SpeedSlider', {
   Text = 'WalkSpeed Value',
   Default = 16,
   Min = 16,
   Max = 100,
   Rounding = 0,
   Callback = function(Value)
      _G.SpeedValue = Value
   end
})

local TeleportGroup = Tabs.Player:AddRightGroupbox("Quick Actions")

TeleportGroup:AddButton({
   Text = 'Teleport to Plot / Shop',
   Func = function()
      pcall(function()
         -- Hahanapin ang local plot gamit ang PlotUtil na nakita natin kanina sa codebase
         local plotUtil = require(game:GetService("Players").LocalPlayer.PlayerScripts.Client.Modules.PlotUtil)
         local plot = plotUtil.GetLocalPlot()
         if plot and plot:FindFirstChild("Interactables") then
            local pad = plot.Interactables:FindFirstChild("BuyItemsButton")
            if pad and pad:FindFirstChild("Pad", true) then
               game:GetService("Players").LocalPlayer.Character.HumanoidRootPart.CFrame = pad.Pad.CFrame + Vector3.new(0, 5, 0)
               Library:Notify({ Title = "Pre Hub", Content = "Teleported to your Shop Pad!", Duration = 2 })
            end
         end
      end)
   end
})

