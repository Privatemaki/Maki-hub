-- ==================== SHOP TAB ====================
local EggGroup = Tabs.Shop:AddLeftGroupbox("Egg Automation")

local EggIdMapping = {
   ["dirt-y egg"] = "DirtyEgg",
   ["basic egg"] = "BasicEgg",
   ["grassy egg"] = "GrassyEgg",
   ["stone egg"] = "StoneEgg",
   ["crystal egg"] = "CrystalEgg",
   ["ocean egg"] = "OceanEgg",
   ["royale egg"] = "RoyalEgg",
   ["blessed egg"] = "BlessedEgg"
}

local SelectedEggs = {}
local EggThread = nil

EggGroup:AddDropdown('EggDropdown', {
   Values = { "dirt-y egg", "basic egg", "grassy egg", "stone egg", "crystal egg", "ocean egg", "royale egg", "blessed egg" },
   Default = 1,
   Multi = true,
   Text = 'Select Eggs to Buy',
   Callback = function(Value)
      SelectedEggs = Value
   end
})

EggGroup:AddToggle('AutoBuyEggsToggle', {
   Text = 'Auto Buy Eggs (Optimized)',
   Default = false,
   Callback = function(Value)
      _G.AutoBuyEggs = Value
      
      if EggThread then
         task.cancel(EggThread)
         EggThread = nil
      end

      if _G.AutoBuyEggs then
         Library:Notify({ Title = "Pre Hub", Content = "Auto Buy Eggs Enabled!", Duration = 2 })
         
         EggThread = task.spawn(function()
            while _G.AutoBuyEggs do
               if SelectedEggs and type(SelectedEggs) == "table" then
                  local anySelected = false
                  for eggName, isSelected in pairs(SelectedEggs) do
                     if isSelected and _G.AutoBuyEggs then
                        anySelected = true
                        local actualId = EggIdMapping[eggName]
                        if actualId then
                           for i = 1, 5 do
                              if not _G.AutoBuyEggs then break end
                              pcall(function()
                                 game:GetService("ReplicatedStorage").Shared.Remotes.PurchaseItem:InvokeServer(actualId, 1)
                              end)
                              task.wait(0.08)
                           end
                        end
                     end
                  end
                  if not anySelected then
                     task.wait(1)
                  end
               end
               task.wait(0.4)
            end
         end)
      else
         Library:Notify({ Title = "Pre Hub", Content = "Auto Buy Eggs Disabled.", Duration = 2 })
      end
   end
})

